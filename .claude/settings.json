{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/style-gate.js"],
            "timeout": 10,
            "statusMessage": "Checking house style"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/style-gate.js"],
            "timeout": 10,
            "statusMessage": "Checking commit trailer"
          }
        ]
      }
    ]
  }
}
